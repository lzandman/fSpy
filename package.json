{
  "name": "fspy",
  "version": "1.1.0-beta.3",
  "main": "out/main/index.js",
  "homepage": "https://fspy.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/stuffmatic/fSpy.git"
  },
  "author": {
    "name": "Per Gantelius",
    "email": "per@stuffmatic.com",
    "url": "https://stuffmatic.com"
  },
  "description": "An open source, cross platform app for still image camera matching",
  "license": "GPL-3.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/minimist": "^1.2.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/react-measure": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "konva": "^9.3.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.14",
    "react-measure": "^2.5.2",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.6"
  },
  "scripts": {
    "start": "cross-env ELECTRON_RUN_AS_NODE= electron-vite dev",
    "build-dist": "electron-vite build",
    "test": "jest",
    "lint": "eslint .",
    "dist-preview": "npm run build-dist && electron-builder --dir",
    "dist": "npm run build-dist && electron-builder -mwl",
    "dist-mac": "npm run build-dist && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -m",
    "dist-win": "npm run build-dist && electron-builder -w",
    "dist-linux": "npm run build-dist && electron-builder -l",
    "publish-release": "npm run build-dist && electron-builder -mwl --publish always"
  },
  "dependencies": {
    "electron-window-state": "^5.0.3",
    "minimist": "^1.2.8"
  },
  "build": {
    "publish": {
      "provider": "github",
      "repo": "fSpy",
      "publishAutoUpdate": false
    },
    "productName": "fSpy",
    "appId": "com.stuffmatic.fspy",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "zip",
          "arch": "x64"
        }
      ]
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/electron",
        "to": "",
        "filter": [
          "example.fspy"
        ]
      },
      {
        "from": "assets/build",
        "to": "",
        "filter": [
          "icon.ico"
        ]
      },
      {
        "from": "assets/electron",
        "to": "",
        "filter": [
          "icon.png"
        ]
      },
      {
        "from": "assets/electron",
        "to": "",
        "filter": [
          "icon.svg"
        ]
      }
    ],
    "directories": {
      "buildResources": "assets/build"
    },
    "fileAssociations": [
      {
        "ext": "fspy",
        "name": "fSpy project",
        "description": "fSpy project file",
        "role": "Editor"
      }
    ]
  }
}
